#ifndef OPAL_WIN32_FWD_TIME_H
#define OPAL_WIN32_FWD_TIME_H
#include "opal_win32_common.h"
#include "@OPAL_CRT_UCRT@/time.h"
/* clockid_t/timer_t may be needed before <sys/types.h> has been
 * processed (Windows headers pull <time.h> while common.h is still
 * being included); define them here under the same guards. */
#ifndef _CLOCKID_T_DEFINED
#    define _CLOCKID_T_DEFINED
typedef int clockid_t;
#endif
#ifndef _TIMER_T_DEFINED
#    define _TIMER_T_DEFINED
typedef void *timer_t;
#endif
/* POSIX clock ids */
#ifndef CLOCK_REALTIME
#    define CLOCK_REALTIME 0
#endif
#ifndef CLOCK_MONOTONIC
#    define CLOCK_MONOTONIC 1
#endif
#ifndef CLOCK_PROCESS_CPUTIME_ID
#    define CLOCK_PROCESS_CPUTIME_ID 2
#endif
#ifndef CLOCK_THREAD_CPUTIME_ID
#    define CLOCK_THREAD_CPUTIME_ID 3
#endif
#ifndef CLOCK_MONOTONIC_RAW
#    define CLOCK_MONOTONIC_RAW 4
#endif
#ifndef CLOCK_REALTIME_COARSE
#    define CLOCK_REALTIME_COARSE 5
#endif
#ifndef CLOCK_MONOTONIC_COARSE
#    define CLOCK_MONOTONIC_COARSE 6
#endif
#ifndef CLOCK_BOOTTIME
#    define CLOCK_BOOTTIME 7
#endif
#ifndef TIMER_ABSTIME
#    define TIMER_ABSTIME 1
#endif
#ifndef _TIMESPEC_DEFINED
#    define _TIMESPEC_DEFINED
#endif
#ifndef _ITIMERSPEC_DEFINED
#    define _ITIMERSPEC_DEFINED
struct itimerspec {
    struct timespec it_interval;
    struct timespec it_value;
};
#endif
struct sigevent;
#ifdef __cplusplus
extern "C" {
#endif
/* literal POSIX names -- no UCRT conflicts */
OPAL_WIN32_DECLSPEC int clock_gettime(clockid_t clk_id, struct timespec *tp);
OPAL_WIN32_DECLSPEC int clock_getres(clockid_t clk_id, struct timespec *res);
OPAL_WIN32_DECLSPEC int clock_settime(clockid_t clk_id, const struct timespec *tp);
OPAL_WIN32_DECLSPEC int nanosleep(const struct timespec *req, struct timespec *rem);
int          timer_create(clockid_t clockid, struct sigevent *sevp,
                          timer_t *timerid);
int          timer_delete(timer_t timerid);
int          timer_settime(timer_t timerid, int flags,
                           const struct itimerspec *new_value,
                           struct itimerspec *old_value);
int          timer_gettime(timer_t timerid, struct itimerspec *curr_value);
int          timer_getoverrun(timer_t timerid);
struct tm   *gmtime_r(const time_t *timep, struct tm *result);
struct tm   *localtime_r(const time_t *timep, struct tm *result);
char        *asctime_r(const struct tm *tm, char *buf);
char        *ctime_r(const time_t *timep, char *buf);
OPAL_WIN32_DECLSPEC time_t timegm(struct tm *tm);
char        *strptime(const char *buf, const char *format, struct tm *tm);
int          stime(const time_t *t);
#ifdef __cplusplus
}
#endif
#endif /* OPAL_WIN32_FWD_TIME_H */
