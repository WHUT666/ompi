#ifndef OPAL_WIN32_FWD_STRING_H
#define OPAL_WIN32_FWD_STRING_H
#include "opal_win32_common.h"
#include "@OPAL_CRT_UCRT@/string.h"
#ifndef strdup
#    define strdup _strdup
#endif
char  *strndup(const char *s, size_t n);
#ifndef strtok_r
#    define strtok_r strtok_s
#endif
#ifndef strcasecmp
#    define strcasecmp _stricmp
#endif
#ifndef strncasecmp
#    define strncasecmp _strnicmp
#endif
#ifndef index
#    define index strchr
#endif
#ifndef rindex
#    define rindex strrchr
#endif
#ifdef __cplusplus
extern "C" {
#endif
char  *strsignal(int sig);
OPAL_WIN32_DECLSPEC int strerror_r(int errnum, char *buf, size_t buflen);
char  *strsep(char **stringp, const char *delim);
void  *memmem(const void *haystack, size_t haystacklen, const void *needle,
              size_t needlelen);
void  *memrchr(const void *s, int c, size_t n);
void  *mempcpy(void *dest, const void *src, size_t n);
char  *stpcpy(char *dest, const char *src);
char  *stpncpy(char *dest, const char *src, size_t n);
void   explicit_bzero(void *s, size_t n);
OPAL_WIN32_DECLSPEC size_t strlcpy(char *dst, const char *src, size_t size);
OPAL_WIN32_DECLSPEC size_t strlcat(char *dst, const char *src, size_t size);
#ifdef __cplusplus
}
#endif
#endif /* OPAL_WIN32_FWD_STRING_H */
